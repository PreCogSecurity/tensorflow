# TensorFlow Environment Variables Configuration
# Copy this file to .env and customize for your environment
# NEVER commit .env files with real secrets to version control

# =============================================================================
# BUILD CONFIGURATION (used by ./configure script)
# =============================================================================

# Python interpreter path (auto-detected if not set)
# PYTHON_BIN_PATH=/usr/bin/python3

# Enable Google Cloud Platform support (GCS, BigQuery, etc.)
# TF_NEED_GCP=0

# Enable GPU/CUDA support
# TF_NEED_CUDA=0

# CUDA toolkit version (e.g., 11.8, 12.1)
# TF_CUDA_VERSION=

# cuDNN version (e.g., 8.6.0, 8.9.0)
# TF_CUDNN_VERSION=

# CUDA toolkit installation path
# CUDA_TOOLKIT_PATH=/usr/local/cuda

# cuDNN installation path
# CUDNN_INSTALL_PATH=/usr/local/cuda

# GCC host compiler path for CUDA compilation
# GCC_HOST_COMPILER_PATH=/usr/bin/gcc

# CUDA compute capabilities to build for (comma-separated)
# Default: 3.5,5.2 (Kepler, Maxwell)
# Common values: 6.0,6.1,7.0,7.5,8.0,8.6,9.0
# TF_CUDA_COMPUTE_CAPABILITIES=7.0,7.5,8.0,8.6

# SWIG path for Python bindings generation
# SWIG_PATH=/usr/bin/swig

# =============================================================================
# RUNTIME CONFIGURATION
# =============================================================================

# TensorFlow logging level
# 0 = all messages, 1 = INFO, 2 = WARNING, 3 = ERROR
# TF_CPP_MIN_LOG_LEVEL=0

# Enable/disable GPU memory growth (prevents OOM on startup)
# TF_FORCE_GPU_ALLOW_GROWTH=true

# GPU memory fraction to allocate per process (0.0-1.0)
# TF_GPU_MEMORY_FRACTION=0.9

# Visible GPU devices (comma-separated, e.g., "0,1" or "0")
# CUDA_VISIBLE_DEVICES=0

# Enable XLA JIT compilation
# TF_XLA_FLAGS=--tf_xla_auto_jit=2

# Enable/disable MKL-DNN optimizations
# TF_ENABLE_MKL=1

# Number of threads for intra-op parallelism
# TF_INTRA_OP_PARALLELISM_THREADS=0 (auto)

# Number of threads for inter-op parallelism
# TF_INTER_OP_PARALLELISM_THREADS=0 (auto)

# =============================================================================
# PROTOCOL BUFFERS CONFIGURATION
# =============================================================================

# Protocol Buffers Python implementation: "cpp" (fast) or "python" (pure Python)
# PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=cpp

# Protocol Buffers Python implementation version
# PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION_VERSION=2

# =============================================================================
# DISTRIBUTED TRAINING CONFIGURATION
# =============================================================================

# gRPC configuration for distributed TensorFlow
# TF_GRPC_MAX_MESSAGE_SIZE=104857600 (100MB)

# Worker timeout in milliseconds
# TF_WORKER_TIMEOUT_MS=60000

# =============================================================================
# TENSORBOARD CONFIGURATION
# =============================================================================

# TensorBoard log directory
# TENSORBOARD_LOGDIR=/tmp/tensorflow/logs

# TensorBoard host and port
# TENSORBOARD_HOST=0.0.0.0
# TENSORBOARD_PORT=6006

# =============================================================================
# SECURITY & AUTHENTICATION (for production deployments)
# =============================================================================

# TLS/SSL certificate paths for secure gRPC communication
# TF_SSL_SERVER_CERTIFICATE=/path/to/server.crt
# TF_SSL_SERVER_KEY=/path/to/server.key
# TF_SSL_ROOT_CERTIFICATE=/path/to/ca.crt

# Authentication token for TensorBoard (if enabled)
# TENSORBOARD_AUTH_TOKEN=

# =============================================================================
# MONITORING & PROFILING
# =============================================================================

# Enable TensorFlow Profiler
# TF_PROFILER_ENABLED=true

# Profiler port
# TF_PROFILER_PORT=9001

# Enable TensorFlow Debugger (tfdbg)
# TF_DEBUG_ENABLED=false

# =============================================================================
# EXPERIMENTAL FEATURES
# =============================================================================

# Enable experimental TensorRT integration
# TF_TENSORRT_ENABLED=0

# Enable experimental quantization
# TF_QUANTIZATION_ENABLED=0

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================

# Test reporter environment (used internally)
# TEST_REPORTER_TEST_ENV=

# Test sharding (used by CI)
# TEST_TOTAL_SHARDS=1
# TEST_SHARD_INDEX=0
# TEST_SHARD_STATUS_FILE=/tmp/shard_status

# Bazel test timeout (seconds)
# TEST_TIMEOUT=300

# =============================================================================
# PYTHON PATH CONFIGURATION
# =============================================================================

# Additional Python path for custom ops
# PYTHONPATH=/path/to/custom/ops:$PYTHONPATH

# =============================================================================
# NOTES
# =============================================================================
# 1. Most variables have sensible defaults and don't need to be set explicitly
# 2. Build-time variables (TF_NEED_*, TF_CUDA_*) are only used during ./configure
# 3. Runtime variables affect TensorFlow behavior when importing/running
# 4. For production, use secret management (Vault, AWS Secrets Manager, etc.)
#    instead of storing secrets in .env files
# 5. See https://www.tensorflow.org/guide/gpu for GPU configuration details
# 6. See https://www.tensorflow.org/guide/distributed_training for distributed setup